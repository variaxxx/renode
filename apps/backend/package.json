{
  "name": "@renode/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "bun --watch src/main.ts",
    "dev:worker": "bun --watch src/worker.ts",
    "start:api": "bun src/main.ts",
    "start:worker": "bun src/worker.ts",
    "build": "bun run db:generate && tsc --noEmit",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate:dev": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:migrate:status": "bunx --bun prisma migrate status",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7"
  }
}
