generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id           String    @id @default(uuid()) @db.Uuid
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  vault        Vault?
  notificationSettings NotificationSettings?

  @@map("owner")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
  @@map("session")
}

model Provider {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(160)
  accountUrl String   @map("account_url") @db.VarChar(2048)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  servers    Server[]
  secret     ProviderSecret?

  @@map("provider")
}

enum ServerStatus {
  ACTIVE
  ARCHIVED
}

enum Currency {
  RUB
  USD
  EUR
}

model Server {
  id                   String       @id @default(uuid()) @db.Uuid
  providerId           String       @map("provider_id") @db.Uuid
  name                 String       @db.VarChar(160)
  purpose              String       @db.VarChar(500)
  status               ServerStatus @default(ACTIVE)
  tariff               String       @db.VarChar(160)
  cost                 Decimal      @db.Decimal(12, 2)
  currency             Currency
  billingPeriodMonths  Int          @map("billing_period_months")
  nextPaymentDate      DateTime?    @map("next_payment_date") @db.Date
  rentalEndDate        DateTime?    @map("rental_end_date") @db.Date
  cancellationDeadline DateTime?    @map("cancellation_deadline") @db.Date
  autoRenew            Boolean      @default(false) @map("auto_renew")
  ipAddress            String?      @map("ip_address") @db.VarChar(45)
  domain               String?      @db.VarChar(253)
  country              String?      @db.VarChar(2)
  project              String?      @db.VarChar(160)
  tags                 String[]     @default([])
  note                 String?      @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  provider             Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)

  payments             Payment[]
  notificationDeliveries NotificationDelivery[]

  @@index([providerId])
  @@index([status, nextPaymentDate])
  @@index([project])
  @@map("server")
}

model Vault {
  id        String           @id @default(uuid()) @db.Uuid
  ownerId   String           @unique @map("owner_id") @db.Uuid
  metadata  Json
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  owner     Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  secrets   ProviderSecret[]

  @@map("vault")
}

model ProviderSecret {
  providerId String   @id @map("provider_id") @db.Uuid
  vaultId    String   @map("vault_id") @db.Uuid
  encrypted  Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  vault      Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@map("provider_secret")
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  serverId        String   @map("server_id") @db.Uuid
  paymentDate     DateTime @map("payment_date") @db.Date
  amount          Decimal  @db.Decimal(12, 2)
  currency        Currency
  nextPaymentDate DateTime @map("next_payment_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")
  ledgerSequence Int @unique @default(autoincrement()) @map("ledger_sequence")
  previousPaymentId String? @map("previous_payment_id") @db.Uuid
  requestKey      String?  @unique @map("request_key") @db.Uuid
  previousPaymentDate DateTime? @map("previous_payment_date") @db.Date
  cancelledAt     DateTime? @map("cancelled_at")
  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)
  server          Server   @relation(fields: [serverId], references: [id], onDelete: Restrict)

  @@index([serverId, paymentDate])
  @@map("payment")
}

model NotificationSettings {
  ownerId String @id @map("owner_id") @db.Uuid
  chatId String? @map("chat_id") @db.VarChar(20)
  threadId Int? @map("thread_id")
  timezone String @default("Europe/Moscow") @db.VarChar(100)
  paymentIntervals Int[] @default([7, 3, 1, 0]) @map("payment_intervals")
  rentalEndIntervals Int[] @default([7, 3, 1, 0]) @map("rental_end_intervals")
  cancellationIntervals Int[] @default([7, 3, 1, 0]) @map("cancellation_intervals")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@map("notification_settings")
}

enum NotificationEventType {
  PAYMENT
  RENTAL_END
  CANCELLATION
}

enum NotificationDeliveryStatus {
  PENDING
  RETRY
  SENT
  FAILED
}

model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid
  serverId String @map("server_id") @db.Uuid
  eventType NotificationEventType @map("event_type")
  eventDate DateTime @map("event_date") @db.Date
  interval Int
  status NotificationDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
  lastError String? @map("last_error") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, eventType, eventDate, interval], map: "notification_delivery_event_key")
  @@index([status, nextAttemptAt])
  @@map("notification_delivery")
}

model WorkerHeartbeat {
 id String @id
 lastCycleAt DateTime @map("last_cycle_at") @db.Timestamptz(3)
 lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
 lastError String? @map("last_error") @db.VarChar(500)
 @@map("worker_heartbeat")
}
