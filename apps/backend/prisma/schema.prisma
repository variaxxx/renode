generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id           String    @id @default(uuid()) @db.Uuid
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("owner")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([expiresAt])
  @@map("session")
}

model Provider {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(160)
  accountUrl String   @map("account_url") @db.VarChar(2048)
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  servers    Server[]

  @@map("provider")
}

enum ServerStatus {
  ACTIVE
  ARCHIVED
}

enum Currency {
  RUB
  USD
  EUR
}

model Server {
  id                   String       @id @default(uuid()) @db.Uuid
  providerId           String       @map("provider_id") @db.Uuid
  name                 String       @db.VarChar(160)
  purpose              String       @db.VarChar(500)
  status               ServerStatus @default(ACTIVE)
  tariff               String       @db.VarChar(160)
  cost                 Decimal      @db.Decimal(12, 2)
  currency             Currency
  billingPeriodMonths  Int          @map("billing_period_months")
  nextPaymentDate      DateTime?    @map("next_payment_date") @db.Date
  rentalEndDate        DateTime?    @map("rental_end_date") @db.Date
  cancellationDeadline DateTime?    @map("cancellation_deadline") @db.Date
  autoRenew            Boolean      @default(false) @map("auto_renew")
  ipAddress            String?      @map("ip_address") @db.VarChar(45)
  domain               String?      @db.VarChar(253)
  project              String?      @db.VarChar(160)
  tags                 String[]     @default([])
  note                 String?      @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  provider             Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([status, nextPaymentDate])
  @@index([project])
  @@map("server")
}
