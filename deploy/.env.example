DOMAIN=renode.example.com
# Local HTTP upstream for Traefik; TLS terminates at Traefik.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
POSTGRES_USER=renode
POSTGRES_DB=renode
POSTGRES_PASSWORD=replace_with_a_unique_password
DATABASE_URL=postgresql://renode:replace_with_a_unique_password@db:5432/renode?schema=public
# Required for Telegram delivery and test messages.
TELEGRAM_BOT_TOKEN=123456:replace_with_your_bot_token
# Use lowercase GitHub owner/repository names and the same immutable SHA tag.
BACKEND_IMAGE=ghcr.io/owner/renode-backend:sha-commit
WEB_IMAGE=ghcr.io/owner/renode-web:sha-commit
